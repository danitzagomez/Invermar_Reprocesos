<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #f4f6f9;
      color: #333;
      padding: 20px;
    }

    header {
      margin-bottom: 24px;
    }

    header h1 {
      font-size: 1.8rem;
      color: #1a202c;
    }

    /* Métrica / Tarjetas */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: #ffffff;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .card h3 {
      font-size: 0.9rem;
      color: #718096;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .card .value {
      font-size: 1.8rem;
      font-weight: bold;
      color: #2d3748;
    }

    /* Gráficos */
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 20px;
    }

    .chart-container {
      background: #ffffff;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .chart-container h2 {
      font-size: 1.1rem;
      margin-bottom: 16px;
      color: #4a5568;
    }

    @media (max-width: 500px) {
      .charts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>Panel de Control / Dashboard</h1>
  </header>

  <!-- Tarjetas de Métricas Clave -->
  <section class="metrics-grid">
    <div class="card">
      <h3>Ventas Totales</h3>
      <div class="value">$24,500</div>
    </div>
    <div class="card">
      <h3>Usuarios Activos</h3>
      <div class="value">1,240</div>
    </div>
    <div class="card">
      <h3>Nuevos Pedidos</h3>
      <div class="value">85</div>
    </div>
    <div class="card">
      <h3>Tasa de Conversión</h3>
      <div class="value">3.2%</div>
    </div>
  </section>

  <!-- Gráficos -->
  <section class="charts-grid">
    <div class="chart-container">
      <h2>Ventas Mensuales (Línea)</h2>
      <canvas id="lineChart"></canvas>
    </div>
    <div class="chart-container">
      <h2>Distribución por Categoría (Dona)</h2>
      <canvas id="doughnutChart"></canvas>
    </div>
  </section>

  <script>
    // Gráfico de Líneas - Ventas Mensuales
    const ctxLine = document.getElementById('lineChart').getContext('2d');
    new Chart(ctxLine, {
      type: 'line',
      data: {
        labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
        datasets: [{
          label: 'Ventas ($)',
          data: [12000, 19000, 15000, 22000, 18000, 24500],
          borderColor: '#3182ce',
          backgroundColor: 'rgba(49, 130, 206, 0.1)',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        }
      }
    });

    // Gráfico de Dona - Distribución
    const ctxDoughnut = document.getElementById('doughnutChart').getContext('2d');
    new Chart(ctxDoughnut, {
      type: 'doughnut',
      data: {
        labels: ['Electrónica', 'Ropa', 'Hogar', 'Otros'],
        datasets: [{
          data: [40, 25, 20, 15],
          backgroundColor: ['#3182ce', '#38a169', '#dd6b20', '#e53e3e']
        }]
      },
      options: {
        responsive: true
      }
    });
  </script>
</body>
</html>
